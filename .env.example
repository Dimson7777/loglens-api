APP_NAME=LogLens API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

LOG_LEVEL=INFO
JSON_LOGS=true
METRICS_ENABLED=true
METRICS_PATH=/metrics
OTEL_ENABLED=false
OTEL_SERVICE_NAME=loglens-api
OTEL_SAMPLE_RATIO=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_TIMEOUT_SECONDS=10.0
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
RELEASE_NAME=loglens-api@0.1.0
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_REQUEST_SIZE_BYTES=1048576
READY_CHECK_TIMEOUT_SECONDS=2.0

JWT_SECRET_KEY=change-me-to-a-strong-32-plus-character-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=loglens
POSTGRES_USER=loglens
POSTGRES_PASSWORD=loglens
DATABASE_URL=postgresql+asyncpg://loglens:loglens@db:5432/loglens
ALEMBIC_DATABASE_URL=postgresql+psycopg://loglens:loglens@db:5432/loglens
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

REDIS_URL=redis://redis:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
CELERY_WORKER_CONCURRENCY=2
